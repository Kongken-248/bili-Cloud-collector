# ============================================================
# 环境变量模板
# 复制本文件为 .env 后按需填写；.env 已被 .gitignore 忽略，不入仓库。
# 所有配置由 core/config.py 读取，代码中不硬编码路径与密钥。
# ============================================================

# ===== B站公开接口配置 =====

# B站 API 基础地址
BILI_API_BASE=https://api.bilibili.com

# 新版排行榜分区名单在 core/config.py 的 PARTITIONS 中定义（分区名→tid）
# 默认六区：游戏1008、动画1005、知识1010、美食1020、影视1001、科技数码1012

# 请求间隔（秒）：全局限速，请求在 [MIN, MAX] 区间内随机等待
REQUEST_INTERVAL_MIN=1.5
REQUEST_INTERVAL_MAX=3.0

# 失败重试次数（指数退避）
RETRY_TIMES=3

# 评论封顶条数 N：每视频仅采一级热评（主楼），不足 N 自然全量
COMMENT_CAP_N=200

# 弹幕对账 ratio 阈值：低于该值的视频在时间分布类分析中剔除或标注
DANMAKU_RATIO_THRESHOLD=0.8

# ===== UP主回查降级触发阈值（工程默认）=====

# 预计剩余采集时长（秒）超过该值，投稿回查降级为分层抽样
UP_DEGRADE_TIME_LIMIT=3600

# 连续风控失败次数达到该值，触发冷却与降级
UP_DEGRADE_RISK_LIMIT=5

# ===== 登录态（仅本地，不入库不入仓）=====

# 弹幕/评论采集需要，从浏览器 Cookie 获取；云端快照不使用
SESSDATA=

# 风控 buvid3（可留空，由程序自动初始化）
BUVID3=

# ===== 大模型（OpenAI 兼容接口，默认留空 = 未配置）=====
# 示例（火山方舟豆包）：BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   API_KEY=ark-xxxx   MODEL=doubao-seed-2-0-lite-260428（全小写+日期版本号，
#   可用 GET {BASE_URL}/models 列出该 key 可用的模型 ID）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 离线降级开关：置 1 强制离线模式（不调用大模型，界面正常出图）
LLM_OFFLINE=0
